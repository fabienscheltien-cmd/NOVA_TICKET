# Modèle des variables de production. Ne JAMAIS committer le fichier rempli ; droits 600 ; secrets dans un coffre.
CONSOLE_HOST=console.exemple.fr
API_HOST=api.exemple.fr
API_IMAGE=registre.exemple.fr/nova/api:TAG
WEB_IMAGE=registre.exemple.fr/nova/web:TAG
# Rôle applicatif nova_app (sans BYPASSRLS), JAMAIS le rôle administrateur. sslmode=require obligatoire vers la base managée.
DATABASE_URL_APP=postgres://nova_app:MOT_DE_PASSE@HOTE:PORT/nova?sslmode=require
# 32 caractères minimum, aléatoire : openssl rand -base64 48
JWT_SECRET=
# Clé AES-256 (32 octets en base64) : openssl rand -base64 32. La perdre rend les secrets MFA illisibles : la sauvegarder à part.
APP_ENCRYPTION_KEY=
RATE_LIMIT_AUTH_PER_MIN=20
