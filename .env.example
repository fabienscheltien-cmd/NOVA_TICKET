# Développement local (docker compose up -d). Valeurs factices, jamais utilisées en production.
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/nova
DATABASE_URL_APP=postgres://nova_app:nova_app_dev@localhost:5432/nova
NOVA_APP_PASSWORD=nova_app_dev
PORT=3000
# Authentification (valeurs factices de développement ; en production : secrets générés et gérés hors dépôt)
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# 32 octets en base64, par exemple : openssl rand -base64 32
APP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_BASE_URL=http://localhost:5173
