# Console web : build statique servi par nginx (non privilégié). L'origine de l'API est injectée à l'exécution (CSP).
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --filter "@nova/web..."
COPY packages/shared packages/shared
COPY apps/web apps/web
# VITE_API_URL est figée dans le build (l'API publique, ex. https://api.exemple.fr).
ARG VITE_API_URL
ENV VITE_DATA_SOURCE=api VITE_API_URL=$VITE_API_URL
RUN pnpm --filter @nova/shared build && pnpm --filter @nova/web build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
# API_ORIGIN (ex. https://api.exemple.fr) est substituée dans le gabarit au démarrage.
ENV API_ORIGIN=
EXPOSE 8080
